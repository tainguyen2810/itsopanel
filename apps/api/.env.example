# ITSO Panel API — cấu hình DEV. Không commit file .env thật.
APP_NAME="ITSO Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16 (docker-compose.dev.yml hoặc cài trực tiếp — xem docs/runbooks/dev-setup.md)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=itso
DB_USERNAME=itso
DB_PASSWORD=itso_dev_only

# Redis 7: cache, queue. Phiên: bảng sessions (driver itso, D-58)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=itso
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="panel@itso.local"
MAIL_FROM_NAME="${APP_NAME}"

# Go agent. Linux: unix socket của mock agent (make dev). Windows dev: bỏ trống SOCKET, đặt URL.
ITSO_AGENT_SOCKET=/tmp/itso-mock-agent.sock
ITSO_AGENT_URL=
ITSO_AGENT_TIMEOUT=5
ITSO_AGENT_CONNECTED_WINDOW=300
# Server local (Phase 3): tạo bằng db:seed, làm mới dữ kiện: php artisan itso:server-local
ITSO_LOCAL_SERVER=true
ITSO_LOCAL_SERVER_NAME=srv-local
ITSO_LOCAL_SERVER_HOSTNAME=localhost

ITSO_VERSION=0.1.0-alpha
ITSO_COMMIT=dev

# CORS: để trống (web gọi API cùng origin). Ví dụ: ITSO_CORS_ORIGINS=http://127.0.0.1:4000
ITSO_CORS_ORIGINS=

# Xác thực (D-58). Production hai origin: đặt host để realm /api/v1/auth/* theo host.
# Một origin (dev, demo): để trống, SPA gửi header X-ITSO-Realm.
ITSO_ADMIN_HOST=
ITSO_PORTAL_HOST=
# URL giao diện (link đặt lại mật khẩu). Mặc định APP_URL/admin và APP_URL/portal.
ITSO_ADMIN_URL=
ITSO_PORTAL_URL=
ITSO_LOGIN_LOCK_THRESHOLD=5
ITSO_LOGIN_IP_THRESHOLD=20
ITSO_MFA_ISSUER=ITSO
