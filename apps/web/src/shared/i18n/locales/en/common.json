  "jobErrors": {
    "generic": "Task failed",
    "config_test_failed": {
      "title": "The new configuration failed its check (nginx -t / php-fpm -t)",
      "hint": "The panel rolled back to the previous configuration, so the website keeps running as before. Read the error line below, fix the configuration (usually custom Nginx config) and save again."
    },
    "precondition_failed": {
      "title": "A precondition is not met",
      "hint": "For example the domain does not point to this server so a certificate cannot be issued, or the version is not supported. Check DNS and the requirements, then try again."
    },
    "invalid_params": {
      "title": "Invalid data",
      "hint": "The server or the provider (Cloudflare) rejected the data. Fix it according to the message below."
    },
    "dependency_unavailable": {
      "title": "A dependency is not responding",
      "hint": "Temporary error (Cloudflare, Let's Encrypt, apt…). The panel retries automatically; if it keeps failing, try again in a few minutes."
    },
    "agent_unavailable": {
      "title": "Cannot reach the agent on the server",
      "hint": "Check the itso-agent service on the server, then try again."
    },
    "quota_exceeded": {
      "title": "Package limit exceeded",
      "hint": "Upgrade the package or free up resources, then try again."
    },
    "busy": {
      "title": "The server is busy",
      "hint": "Another operation holds a lock (for example apt). Try again in a few minutes."
    },
    "deadline_exceeded": {
      "title": "Timed out",
      "hint": "The step ran too long and was stopped. Try again; if it repeats, check the server load."
    },
    "timed_out": {
      "title": "Timed out",
      "hint": "The task exceeded its time limit. Try again; if it repeats, check the server load."
    },
    "already_exists": {
      "title": "Already exists",
      "hint": "An object with the same name but a different configuration exists on the server. Rename it or remove the old one."
    },
    "not_found": {
      "title": "Not found",
      "hint": "The object may have been removed on the server. Reload the page and try again."
    },
    "internal": {
      "title": "Internal agent error",
      "hint": "Try again; if it repeats, check the itso-agent logs on the server."
    }
  },
