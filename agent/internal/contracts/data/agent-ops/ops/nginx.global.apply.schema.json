{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/nginx.global.apply.schema.json",
  "title": "nginx.global.apply",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "worker_processes": {
          "type": "string",
          "pattern": "^(auto|[0-9]{1,3})$"
        },
        "worker_connections": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65535
        },
        "client_max_body_size": {
          "$ref": "../defs.schema.json#/$defs/NginxSize"
        },
        "gzip": {
          "type": "boolean"
        },
        "http2": {
          "type": "boolean"
        },
        "server_tokens": {
          "type": "boolean"
        }
      },
      "required": [
        "worker_processes",
        "worker_connections",
        "client_max_body_size",
        "gzip",
        "http2",
        "server_tokens"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "nginx_test": {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        "reloaded": {
          "type": "boolean"
        }
      },
      "required": [
        "nginx_test",
        "reloaded"
      ],
      "additionalProperties": false
    }
  }
}
