{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/nginx.vhost.inspect.schema.json",
  "title": "nginx.vhost.inspect",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "website_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        }
      },
      "required": [
        "website_uuid"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "config": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 65536
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "exists",
        "config",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
