{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/fs.list.schema.json",
  "title": "fs.list",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "path": {
          "$ref": "../defs.schema.json#/$defs/RelPath"
        },
        "show_hidden": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      },
      "required": [
        "account",
        "path"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 255
              },
              "type": {
                "$ref": "../defs.schema.json#/$defs/FileType"
              },
              "size": {
                "$ref": "../defs.schema.json#/$defs/Bytes"
              },
              "mode": {
                "$ref": "../defs.schema.json#/$defs/Mode"
              },
              "modified_at": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096
              }
            },
            "required": [
              "name",
              "type",
              "size",
              "mode",
              "modified_at",
              "target"
            ],
            "additionalProperties": false
          },
          "maxItems": 5000
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "truncated"
      ],
      "additionalProperties": false
    }
  }
}
