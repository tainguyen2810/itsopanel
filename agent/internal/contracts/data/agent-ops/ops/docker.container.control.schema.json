{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/docker.container.control.schema.json",
  "title": "docker.container.control",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "../defs.schema.json#/$defs/ContainerId"
        },
        "action": {
          "type": "string",
          "enum": [
            "start",
            "stop",
            "restart"
          ]
        }
      },
      "required": [
        "id",
        "action"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    }
  }
}
