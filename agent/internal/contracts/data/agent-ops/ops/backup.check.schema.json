{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/backup.check.schema.json",
  "title": "backup.check",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "../defs.schema.json#/$defs/BackupRepo"
        },
        "read_data_subset": {
          "type": "string",
          "pattern": "^[0-9]{1,2}%$"
        }
      },
      "required": [
        "repo",
        "read_data_subset"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ok",
        "errors"
      ],
      "additionalProperties": false
    }
  }
}
