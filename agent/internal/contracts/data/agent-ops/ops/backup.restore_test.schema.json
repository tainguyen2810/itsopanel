{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/backup.restore_test.schema.json",
  "title": "backup.restore_test",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "../defs.schema.json#/$defs/BackupRepo"
        },
        "snapshot_id": {
          "$ref": "../defs.schema.json#/$defs/ResticSnapshotId"
        },
        "sample_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "databases": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/BackupDb"
          },
          "maxItems": 5
        }
      },
      "required": [
        "repo",
        "snapshot_id",
        "sample_files",
        "databases"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "verified_files": {
          "type": "integer",
          "minimum": 0
        },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "../defs.schema.json#/$defs/RelPath"
              },
              "expected_sha256": {
                "$ref": "../defs.schema.json#/$defs/Sha256"
              },
              "actual_sha256": {
                "oneOf": [
                  {
                    "$ref": "../defs.schema.json#/$defs/Sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "path",
              "expected_sha256",
              "actual_sha256"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "databases_ok": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ok",
        "verified_files",
        "mismatches",
        "databases_ok"
      ],
      "additionalProperties": false
    }
  }
}
