{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/backup.restore_test.schema.json",
  "title": "backup.restore_test",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "../defs.schema.json#/$defs/BackupRepo"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8,64}$"
        },
        "sample_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "repo",
        "snapshot_id",
        "sample_files"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "verified_files": {
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "verified_files"
      ],
      "additionalProperties": false
    }
  }
}
