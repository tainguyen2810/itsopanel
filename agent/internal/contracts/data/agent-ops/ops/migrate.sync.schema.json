{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/migrate.sync.schema.json",
  "title": "migrate.sync",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "target_server_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        },
        "pass": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "account",
        "target_server_uuid",
        "pass"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "bytes": {
          "$ref": "../defs.schema.json#/$defs/Bytes"
        }
      },
      "required": [
        "bytes"
      ],
      "additionalProperties": false
    }
  }
}
