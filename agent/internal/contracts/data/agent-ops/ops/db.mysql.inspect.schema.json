{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/db.mysql.inspect.schema.json",
  "title": "db.mysql.inspect",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        }
      },
      "required": [
        "account"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "../defs.schema.json#/$defs/DbName"
              },
              "size_bytes": {
                "$ref": "../defs.schema.json#/$defs/Bytes"
              }
            },
            "required": [
              "name",
              "size_bytes"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/DbName"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "databases",
        "users"
      ],
      "additionalProperties": false
    }
  }
}
