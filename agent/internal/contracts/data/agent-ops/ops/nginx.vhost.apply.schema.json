{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/nginx.vhost.apply.schema.json",
  "title": "nginx.vhost.apply",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "website_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        },
        "site_dir": {
          "$ref": "../defs.schema.json#/$defs/Domain"
        },
        "type": {
          "$ref": "../defs.schema.json#/$defs/SiteType"
        },
        "server_names": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/Domain"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "redirect_names": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/Domain"
          },
          "maxItems": 100
        },
        "document_root": {
          "$ref": "../defs.schema.json#/$defs/RelPath"
        },
        "php_socket": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^/run/itso/php/[a-z][a-z0-9]{2,15}-[0-9a-f]{8}\\.sock$"
        },
        "proxy_port": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1024,
          "maximum": 65535
        },
        "tls": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "cert_uuid": {
              "$ref": "../defs.schema.json#/$defs/Uuid"
            },
            "hsts": {
              "type": "boolean"
            },
            "force_https": {
              "type": "boolean"
            }
          },
          "required": [
            "cert_uuid",
            "hsts",
            "force_https"
          ],
          "additionalProperties": false
        },
        "http2": {
          "type": "boolean"
        },
        "client_max_body_size": {
          "$ref": "../defs.schema.json#/$defs/NginxSize"
        },
        "extra_headers": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "$ref": "../defs.schema.json#/$defs/HeaderValue"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9-]{1,63}$"
          }
        },
        "redirects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "$ref": "../defs.schema.json#/$defs/UrlPath"
              },
              "to": {
                "$ref": "../defs.schema.json#/$defs/RedirectTarget"
              },
              "code": {
                "type": "string",
                "enum": [
                  "301",
                  "302"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "code"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "suspended": {
          "type": "boolean"
        },
        "wp_hardening": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "xmlrpc_blocked": {
              "type": "boolean"
            },
            "php_in_uploads_blocked": {
              "type": "boolean"
            }
          },
          "required": [
            "xmlrpc_blocked",
            "php_in_uploads_blocked"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "account",
        "website_uuid",
        "site_dir",
        "type",
        "server_names",
        "document_root"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "config_path": {
          "type": "string"
        },
        "nginx_test": {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        "reloaded": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "config_path",
        "nginx_test",
        "reloaded",
        "changed"
      ],
      "additionalProperties": false
    }
  }
}
