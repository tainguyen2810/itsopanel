{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/db.mysql.grant.schema.json",
  "title": "db.mysql.grant",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "username": {
          "$ref": "../defs.schema.json#/$defs/DbName"
        },
        "database": {
          "$ref": "../defs.schema.json#/$defs/DbName"
        },
        "privileges": {
          "$ref": "../defs.schema.json#/$defs/DbPrivileges"
        }
      },
      "required": [
        "account",
        "username",
        "database",
        "privileges"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "granted": {
          "type": "boolean"
        }
      },
      "required": [
        "granted"
      ],
      "additionalProperties": false
    }
  }
}
