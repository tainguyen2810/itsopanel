{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/sftp.user.ensure.schema.json",
  "title": "sftp.user.ensure",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "ssh_access": {
          "type": "boolean"
        },
        "password": {
          "oneOf": [
            {
              "$ref": "../defs.schema.json#/$defs/SecretPassword"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "account",
        "ssh_access",
        "password"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string",
          "enum": [
            "itso-sftp",
            "itso-ssh"
          ]
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "group",
        "changed"
      ],
      "additionalProperties": false
    }
  }
}
