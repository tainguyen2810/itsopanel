{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/backup.restore.schema.json",
  "title": "backup.restore",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "../defs.schema.json#/$defs/BackupRepo"
        },
        "snapshot_id": {
          "$ref": "../defs.schema.json#/$defs/ResticSnapshotId"
        },
        "restore_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        },
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "mode": {
          "type": "string",
          "enum": [
            "new",
            "overwrite"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/BackupRestoreItem"
          },
          "minItems": 1,
          "maxItems": 50
        },
        "pre_restore_tags": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/BackupTag"
          },
          "maxItems": 20,
          "uniqueItems": true
        }
      },
      "required": [
        "repo",
        "snapshot_id",
        "restore_uuid",
        "account",
        "mode",
        "items",
        "pre_restore_tags"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "restored_paths": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/RelPath"
          },
          "maxItems": 50
        },
        "databases": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/DbName"
          },
          "maxItems": 50
        },
        "pre_restore_snapshot_id": {
          "oneOf": [
            {
              "$ref": "../defs.schema.json#/$defs/ResticSnapshotId"
            },
            {
              "type": "null"
            }
          ]
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "../defs.schema.json#/$defs/RelPath"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "symlink",
                  "device",
                  "setuid",
                  "outside_home"
                ]
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "restored_paths",
        "databases",
        "pre_restore_snapshot_id",
        "skipped"
      ],
      "additionalProperties": false
    }
  }
}
