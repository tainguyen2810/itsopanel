{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/fs.copy.schema.json",
  "title": "fs.copy",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/RelPath"
          },
          "minItems": 1,
          "maxItems": 500
        },
        "target": {
          "$ref": "../defs.schema.json#/$defs/RelPath"
        }
      },
      "required": [
        "account",
        "paths",
        "target"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "copied": {
          "type": "integer"
        }
      },
      "required": [
        "copied"
      ],
      "additionalProperties": false
    }
  }
}
