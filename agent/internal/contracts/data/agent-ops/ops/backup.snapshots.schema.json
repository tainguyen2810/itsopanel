{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/backup.snapshots.schema.json",
  "title": "backup.snapshots",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "../defs.schema.json#/$defs/BackupRepo"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/BackupTag"
          },
          "maxItems": 5
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "repo",
        "tags",
        "limit"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "../defs.schema.json#/$defs/ResticSnapshotId"
              },
              "time": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 100
                },
                "maxItems": 20
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 4096
                },
                "maxItems": 50
              },
              "hostname": {
                "type": "string",
                "maxLength": 253
              },
              "size_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "id",
              "time",
              "tags",
              "paths",
              "hostname",
              "size_bytes"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "snapshots"
      ],
      "additionalProperties": false
    }
  }
}
