{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/fs.extract.schema.json",
  "title": "fs.extract",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "archive": {
          "$ref": "../defs.schema.json#/$defs/RelPath"
        },
        "target": {
          "$ref": "../defs.schema.json#/$defs/RelPath"
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 53687091200
        },
        "max_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        }
      },
      "required": [
        "account",
        "archive",
        "target",
        "max_total_bytes",
        "max_entries"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "integer"
        },
        "size": {
          "$ref": "../defs.schema.json#/$defs/Bytes"
        },
        "skipped": {
          "type": "integer",
          "description": "Mục bị bỏ qua: symlink, hardlink, thiết bị"
        }
      },
      "required": [
        "entries",
        "size",
        "skipped"
      ],
      "additionalProperties": false
    }
  }
}
