{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/migrate.verify.schema.json",
  "title": "migrate.verify",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "target_server_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        }
      },
      "required": [
        "account",
        "target_server_uuid"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "files_checked": {
          "type": "integer"
        },
        "mismatched": {
          "type": "integer"
        },
        "databases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "files_checked",
        "mismatched",
        "databases"
      ],
      "additionalProperties": false
    }
  }
}
