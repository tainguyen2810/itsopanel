{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/backup.repo.init.schema.json",
  "title": "backup.repo.init",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "../defs.schema.json#/$defs/BackupRepo"
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "initialized": {
          "type": "boolean"
        },
        "already_existed": {
          "type": "boolean"
        }
      },
      "required": [
        "initialized",
        "already_existed"
      ],
      "additionalProperties": false
    }
  }
}
