{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/migrate.cutover.schema.json",
  "title": "migrate.cutover",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "migration_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        },
        "role": {
          "$ref": "../defs.schema.json#/$defs/MigrationRole"
        }
      },
      "required": [
        "account",
        "migration_uuid",
        "role"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "done": {
          "type": "boolean"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "done",
        "at"
      ],
      "additionalProperties": false
    }
  }
}
