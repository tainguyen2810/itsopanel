{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/migrate.preflight.schema.json",
  "title": "migrate.preflight",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "migration_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        },
        "repo": {
          "$ref": "../defs.schema.json#/$defs/BackupRepo"
        },
        "need_bytes": {
          "$ref": "../defs.schema.json#/$defs/Bytes"
        },
        "php_versions": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/PhpVersion"
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "databases": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/BackupDb"
          },
          "maxItems": 100
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/Domain"
          },
          "maxItems": 100
        }
      },
      "required": [
        "account",
        "migration_uuid",
        "repo",
        "need_bytes",
        "php_versions",
        "databases",
        "sites"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z_]{2,32}$"
              },
              "level": {
                "type": "string",
                "enum": [
                  "ok",
                  "warn",
                  "block"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "key",
              "level",
              "message"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        }
      },
      "required": [
        "ok",
        "checks"
      ],
      "additionalProperties": false
    }
  }
}
