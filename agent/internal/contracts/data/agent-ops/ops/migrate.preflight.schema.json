{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/migrate.preflight.schema.json",
  "title": "migrate.preflight",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "target_server_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        }
      },
      "required": [
        "account",
        "target_server_uuid"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "ok",
              "detail"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ok",
        "checks"
      ],
      "additionalProperties": false
    }
  }
}
