{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/db.pg.user_ensure.schema.json",
  "title": "db.pg.user_ensure",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "username": {
          "$ref": "../defs.schema.json#/$defs/DbName"
        },
        "password": {
          "oneOf": [
            {
              "$ref": "../defs.schema.json#/$defs/SecretPassword"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "type": "string",
          "enum": [
            "localhost",
            "%"
          ]
        },
        "max_connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "account",
        "username",
        "password",
        "host",
        "max_connections"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "created": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "created",
        "changed"
      ],
      "additionalProperties": false
    }
  }
}
