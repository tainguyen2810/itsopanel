{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/docker.host.configure.schema.json",
  "title": "docker.host.configure",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "log_max_size_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "log_max_file": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "log_max_size_mb",
        "log_max_file"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "restarted": {
          "type": "boolean"
        },
        "removed_group_members": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/Username"
          },
          "maxItems": 100
        }
      },
      "required": [
        "changed",
        "restarted",
        "removed_group_members"
      ],
      "additionalProperties": false
    }
  }
}
