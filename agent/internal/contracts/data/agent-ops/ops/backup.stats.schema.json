{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/backup.stats.schema.json",
  "title": "backup.stats",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "../defs.schema.json#/$defs/BackupRepo"
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "raw_size_bytes": {
          "$ref": "../defs.schema.json#/$defs/Bytes"
        },
        "restore_size_bytes": {
          "$ref": "../defs.schema.json#/$defs/Bytes"
        },
        "snapshots": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "raw_size_bytes",
        "restore_size_bytes",
        "snapshots"
      ],
      "additionalProperties": false
    }
  }
}
