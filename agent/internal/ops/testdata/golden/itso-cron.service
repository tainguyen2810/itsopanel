# Sinh bởi itso-agent (cron.apply) · account anphat · không sửa tay
[Unit]
Description=ITSO cron 01938a0d-0001-7000-8000-00000d000001 (anphat)

[Service]
Type=oneshot
User=anphat
Group=anphat
Slice=itso-acct-20001.slice
