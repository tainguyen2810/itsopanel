--pty
--quiet
--collect
--service-type=exec
--unit=itso-term-01938a25-0001-7000-8000-0000000000aa.service
--uid=20001
--gid=20001
--slice=itso-acct-20001.slice
-p
ProtectSystem=strict
-p
ProtectHome=tmpfs
-p
BindPaths=/home/anphat
-p
PrivateTmp=yes
-p
PrivateDevices=yes
-p
NoNewPrivileges=yes
-p
RestrictSUIDSGID=yes
-p
ProtectKernelTunables=yes
-p
ProtectKernelModules=yes
-p
ProtectControlGroups=yes
-p
ProtectProc=invisible
-p
ProcSubset=pid
--working-directory=/home/anphat
-E
HOME=/home/anphat
-E
USER=anphat
-E
LOGNAME=anphat
-E
SHELL=/bin/bash
-E
TERM=xterm-256color
-E
LANG=C.UTF-8
/bin/bash
-l
