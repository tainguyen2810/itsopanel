{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/metrics.cgroup.schema.json",
  "title": "metrics.cgroup",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/Account"
          },
          "maxItems": 1000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "username": {
                "$ref": "../defs.schema.json#/$defs/Username"
              },
              "cpu_usage_usec": {
                "type": "integer",
                "minimum": 0
              },
              "cpu_throttled_usec": {
                "type": "integer",
                "minimum": 0
              },
              "memory_current_mb": {
                "type": "integer",
                "minimum": 0
              },
              "memory_max_mb": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "pids_current": {
                "type": "integer",
                "minimum": 0
              },
              "oom_kills": {
                "type": "integer",
                "minimum": 0
              },
              "cpu_pct": {
                "type": "number",
                "minimum": 0
              },
              "io_read_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "io_write_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "io_read_bps": {
                "type": "number",
                "minimum": 0
              },
              "io_write_bps": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "username",
              "cpu_usage_usec",
              "cpu_throttled_usec",
              "memory_current_mb",
              "memory_max_mb",
              "pids_current",
              "oom_kills",
              "cpu_pct",
              "io_read_bytes",
              "io_write_bytes",
              "io_read_bps",
              "io_write_bps"
            ],
            "additionalProperties": false
          }
        },
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "accounts",
        "sampled_at"
      ],
      "additionalProperties": false
    }
  }
}
