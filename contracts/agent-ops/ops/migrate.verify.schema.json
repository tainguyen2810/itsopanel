{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/migrate.verify.schema.json",
  "title": "migrate.verify",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "migration_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        },
        "repo": {
          "$ref": "../defs.schema.json#/$defs/BackupRepo"
        },
        "snapshot_id": {
          "$ref": "../defs.schema.json#/$defs/ResticSnapshotId"
        },
        "databases": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/BackupDb"
          },
          "maxItems": 100
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/Domain"
          },
          "maxItems": 100
        }
      },
      "required": [
        "account",
        "migration_uuid",
        "repo",
        "snapshot_id",
        "databases",
        "sites"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/MigrationCheck"
          },
          "maxItems": 500
        }
      },
      "required": [
        "ok",
        "checks"
      ],
      "additionalProperties": false
    }
  }
}
