{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/php.version.install.schema.json",
  "title": "php.version.install",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "../defs.schema.json#/$defs/PhpVersion"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/PhpExtension"
          },
          "maxItems": 20
        }
      },
      "required": [
        "version",
        "extensions"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "installed": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "installed",
        "changed"
      ],
      "additionalProperties": false
    }
  }
}
