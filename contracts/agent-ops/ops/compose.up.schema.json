{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/compose.up.schema.json",
  "title": "compose.up",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "../defs.schema.json#/$defs/ComposeProjectRef"
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "running",
        "total"
      ],
      "additionalProperties": false
    }
  }
}
