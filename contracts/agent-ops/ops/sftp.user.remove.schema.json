{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/sftp.user.remove.schema.json",
  "title": "sftp.user.remove",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,31}$"
        }
      },
      "required": [
        "account",
        "username"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "removed": {
          "type": "boolean"
        }
      },
      "required": [
        "removed"
      ],
      "additionalProperties": false
    }
  }
}
