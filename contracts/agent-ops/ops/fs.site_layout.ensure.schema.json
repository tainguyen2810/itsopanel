        "site_dir"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "created": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "created"
      ],
      "additionalProperties": false
    }
  }
}
