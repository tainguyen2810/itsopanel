{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/backup.run.schema.json",
  "title": "backup.run",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "../defs.schema.json#/$defs/BackupRepo"
        },
        "kind": {
          "type": "string",
          "enum": [
            "files",
            "db",
            "config",
            "panel"
          ]
        },
        "account": {
          "oneOf": [
            {
              "$ref": "../defs.schema.json#/$defs/Account"
            },
            {
              "type": "null"
            }
          ]
        },
        "website_uuid": {
          "oneOf": [
            {
              "$ref": "../defs.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "site_dir": {
          "oneOf": [
            {
              "$ref": "../defs.schema.json#/$defs/Domain"
            },
            {
              "type": "null"
            }
          ]
        },
        "databases": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/BackupDb"
          },
          "maxItems": 200
        },
        "excludes": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/BackupExclude"
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/BackupTag"
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "age_recipient": {
          "oneOf": [
            {
              "$ref": "../defs.schema.json#/$defs/AgeRecipient"
            },
            {
              "type": "null"
            }
          ]
        },
        "meta": {
          "type": "object",
          "properties": {
            "panel_version": {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9A-Za-z.+-]{1,40}$"
            },
            "server_uuid": {
              "$ref": "../defs.schema.json#/$defs/Uuid"
            },
            "account_uuid": {
              "oneOf": [
                {
                  "$ref": "../defs.schema.json#/$defs/Uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "package": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80,
              "pattern": "^[^\\x00-\\x1f]*$"
            }
          },
          "required": [
            "panel_version",
            "server_uuid",
            "account_uuid",
            "package"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "repo",
        "kind",
        "account",
        "website_uuid",
        "site_dir",
        "databases",
        "excludes",
        "tags",
        "age_recipient",
        "meta"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "$ref": "../defs.schema.json#/$defs/ResticSnapshotId"
        },
        "size_bytes": {
          "$ref": "../defs.schema.json#/$defs/Bytes"
        },
        "bytes_added": {
          "$ref": "../defs.schema.json#/$defs/Bytes"
        },
        "files_new": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_sha256": {
          "$ref": "../defs.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "snapshot_id",
        "size_bytes",
        "bytes_added",
        "files_new",
        "duration_ms",
        "manifest_sha256"
      ],
      "additionalProperties": false
    }
  }
}
