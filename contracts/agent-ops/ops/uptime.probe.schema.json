{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/uptime.probe.schema.json",
  "title": "uptime.probe",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/UptimeTarget"
          },
          "minItems": 1,
          "maxItems": 50
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "targets",
        "timeout_sec"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check_uuid": {
                "$ref": "../defs.schema.json#/$defs/Uuid"
              },
              "ok": {
                "type": "boolean"
              },
              "status": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 599
              },
              "duration_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cert_expires_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "keyword_found": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 300
              }
            },
            "required": [
              "check_uuid",
              "ok",
              "status",
              "duration_ms",
              "cert_expires_at",
              "keyword_found",
              "error"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        }
      },
      "required": [
        "results"
      ],
      "additionalProperties": false
    }
  }
}
