{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/cert.install.schema.json",
  "title": "cert.install",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "website_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        },
        "cert_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        },
        "certificate_pem": {
          "type": "string",
          "maxLength": 65536,
          "pattern": "^-----BEGIN CERTIFICATE-----"
        },
        "private_key_pem": {
          "type": "string",
          "maxLength": 16384,
          "pattern": "^-----BEGIN (EC |RSA )?PRIVATE KEY-----",
          "writeOnly": true
        }
      },
      "required": [
        "account",
        "website_uuid",
        "cert_uuid",
        "certificate_pem",
        "private_key_pem"
      ],
      "additionalProperties": false
    },
    "result": {
      "$ref": "../defs.schema.json#/$defs/CertInfo"
    }
  }
}
