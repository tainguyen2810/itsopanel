{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/wp.admin_password.schema.json",
  "title": "wp.admin_password",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "site": {
          "$ref": "../defs.schema.json#/$defs/WpSite"
        },
        "user": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,59}$"
        },
        "password": {
          "$ref": "../defs.schema.json#/$defs/SecretPassword",
          "writeOnly": true
        }
      },
      "required": [
        "site",
        "user",
        "password"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "changed"
      ],
      "additionalProperties": false
    }
  }
}
