{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/cert.issue.schema.json",
  "title": "cert.issue",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "website_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        },
        "cert_uuid": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        },
        "site_dir": {
          "$ref": "../defs.schema.json#/$defs/Domain"
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/Domain"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "challenge": {
          "type": "string",
          "enum": [
            "http-01"
          ]
        },
        "email": {
          "$ref": "../defs.schema.json#/$defs/Email"
        },
        "directory": {
          "$ref": "../defs.schema.json#/$defs/AcmeDirectory"
        },
        "renew": {
          "type": "boolean"
        }
      },
      "required": [
        "account",
        "website_uuid",
        "cert_uuid",
        "site_dir",
        "domains",
        "challenge",
        "email",
        "directory",
        "renew"
      ],
      "additionalProperties": false
    },
    "result": {
      "$ref": "../defs.schema.json#/$defs/CertInfo"
    }
  }
}
