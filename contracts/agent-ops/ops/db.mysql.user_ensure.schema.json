{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/db.mysql.user_ensure.schema.json",
  "title": "db.mysql.user_ensure",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "../defs.schema.json#/$defs/Account"
        },
        "username": {
          "$ref": "../defs.schema.json#/$defs/DbName"
        },
        "password_ref": {
          "$ref": "../defs.schema.json#/$defs/Uuid"
        },
        "host": {
          "type": "string",
          "enum": [
            "localhost",
            "%"
          ]
        }
      },
      "required": [
        "account",
        "username",
        "password_ref",
        "host"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "created": {
          "type": "boolean"
        }
      },
      "required": [
        "created"
      ],
      "additionalProperties": false
    }
  }
}
