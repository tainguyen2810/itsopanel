{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/ops/backup.forget.schema.json",
  "title": "backup.forget",
  "$defs": {
    "params": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "../defs.schema.json#/$defs/BackupRepo"
        },
        "snapshot_ids": {
          "type": "array",
          "items": {
            "$ref": "../defs.schema.json#/$defs/ResticSnapshotId"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "prune": {
          "type": "boolean"
        }
      },
      "required": [
        "repo",
        "snapshot_ids",
        "prune"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "forgotten": {
          "type": "integer",
          "minimum": 0
        },
        "pruned": {
          "type": "boolean"
        }
      },
      "required": [
        "forgotten",
        "pruned"
      ],
      "additionalProperties": false
    }
  }
}
