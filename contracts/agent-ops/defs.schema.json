{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/defs.schema.json",
  "title": "Kiểu dùng chung cho agent ops",
  "$defs": {
    "Domain": {
      "type": "string",
      "minLength": 4,
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+(xn--[a-z0-9-]{1,59}|[a-z]{2,63})$",
      "description": "Tên miền chữ thường, đã chuyển punycode. Kiểm thêm ở tầng nghiệp vụ: cấm localhost, IP, tên panel."
    },
    "Username": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,15}$",
      "not": {
        "enum": [
          "root",
          "admin",
          "www",
          "mysql",
          "postgres",
          "redis",
          "nginx",
          "itso",
          "daemon",
          "bin",
          "sys",
          "sync",
          "games",
          "man",
          "mail",
          "news",
          "proxy",
          "backup",
          "list",
          "nobody",
          "systemd",
          "sshd",
          "ftp",
          "test",
          "user",
          "support"
        ]
      },
      "description": "Username Linux của hosting account."
    },
    "RelPath": {
      "type": "string",
      "maxLength": 4096,
      "oneOf": [
        {
          "const": "."
        },
        {
          "pattern": "^[^/\\x00-\\x1f]+(/[^/\\x00-\\x1f]+)*$",
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        }
      ],
      "description": "Đường dẫn TƯƠNG ĐỐI với home của account. `.` là thư mục gốc. Cấm `..`, ký tự điều khiển, đường dẫn tuyệt đối."
    },
    "DbName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Tên database/DB user. Tầng nghiệp vụ bắt buộc tiền tố `<username>_`."
    },
    "CronExpr": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^([0-9*,/-]+) ([0-9*,/-]+) ([0-9*,/-]+) ([0-9*,/-]+) ([0-9*,/-]+)$",
      "description": "Biểu thức cron 5 trường dạng số. Khoảng tối thiểu theo gói kiểm ở tầng nghiệp vụ."
    },
    "CronCommand": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": {
        "pattern": "[\\r\\n\\x00]"
      },
      "description": "Lệnh chạy dưới UID của account. Một dòng, không ký tự xuống dòng (chống chèn crontab)."
    },
    "SecretPassword": {
      "type": "string",
      "minLength": 12,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~!@#%^*+=:,-]+$",
      "not": {
        "pattern": "[\\r\\n]"
      },
      "writeOnly": true,
      "description": "Mật khẩu DB/FTP/SFTP. Tới agent chỉ qua tham chiếu bí mật do JobRunner thay (D-69/D-71); không có dấu nháy, gạch chéo ngược, khoảng trắng."
    },
    "FtpUsername": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,47}$",
      "description": "Virtual user Pure-FTPd (D-73). Tầng nghiệp vụ bắt buộc tiền tố `<username>_`."
    },
    "NginxSize": {
      "type": "string",
      "pattern": "^[0-9]{1,5}[kmg]?$",
      "description": "Giá trị kích thước Nginx, ví dụ 64m."
    },
    "HeaderValue": {
      "type": "string",
      "maxLength": 512,
      "not": {
        "pattern": "[;{}\\r\\n\\x00\"'\\\\$]"
      },
      "description": "Giá trị đưa vào cấu hình Nginx: cấm ký tự phá cú pháp."
    },
    "PhpVersion": {
      "type": "string",
      "pattern": "^[5-9]\\.[0-9]$"
    },
    "UrlPath": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^/[A-Za-z0-9._~%/-]*$",
      "description": "Đường dẫn URL cho redirect/location: không khoảng trắng, dấu nháy, $, ;, {}."
    },
    "RedirectTarget": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^https?://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}(:[0-9]{1,5})?(/[A-Za-z0-9._~%/-]*)?$",
      "description": "URL đích redirect (http/https, domain chữ thường, path an toàn)."
    },
    "Cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}(/([0-9]|[12][0-9]|3[0-2]))?$|^[0-9a-f:]+(/[0-9]{1,3})?$"
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Uid": {
      "type": "integer",
      "minimum": 20000,
      "maximum": 59999,
      "description": "UID hosting account (D-07)."
    },
    "ServiceName": {
      "type": "string",
      "enum": [
        "nginx",
        "php8.1-fpm",
        "php8.2-fpm",
        "php8.3-fpm",
        "php8.4-fpm",
        "mariadb",
        "postgresql",
        "redis-server",
        "fail2ban",
        "cron",
        "ssh",
        "itso-gateway"
      ]
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
      "description": "Hostname máy chủ (RFC 1123, chữ thường)."
    },
    "Recipe": {
      "type": "string",
      "enum": [
        "acl",
        "quota",
        "nftables",
        "restic",
        "stress-ng",
        "nginx",
        "php8.3",
        "lego",
        "mariadb",
        "postgresql",
        "pure-ftpd",
        "fail2ban",
        "clamav",
        "yara",
        "modsecurity"
      ]
    },
    "QuotaMode": {
      "type": "string",
      "enum": [
        "kernel",
        "soft"
      ]
    },
    "Mode": {
      "type": "string",
      "pattern": "^0[0-7]{3}$"
    },
    "Bytes": {
      "type": "integer",
      "minimum": 0
    },
    "Limits": {
      "type": "object",
      "properties": {
        "disk_mb": {
          "type": "integer",
          "minimum": 1
        },
        "inode_limit": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6400
        },
        "ram_mb": {
          "type": "integer",
          "minimum": 64
        },
        "tasks_max": {
          "type": "integer",
          "minimum": 16
        },
        "io_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "io_read_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "io_write_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "disk_mb",
        "inode_limit",
        "cpu_percent",
        "ram_mb",
        "tasks_max",
        "io_weight",
        "io_read_bps",
        "io_write_bps"
      ],
      "additionalProperties": false
    },
    "Account": {
      "type": "object",
      "properties": {
        "username": {
          "$ref": "defs.schema.json#/$defs/Username"
        },
        "uid": {
          "$ref": "defs.schema.json#/$defs/Uid"
        }
      },
      "required": [
        "username",
        "uid"
      ],
      "additionalProperties": false
    },
    "Email": {
      "type": "string",
      "maxLength": 190,
      "pattern": "^[A-Za-z0-9._%+-]+@([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "PhpExtension": {
      "type": "string",
      "enum": [
        "bcmath",
        "curl",
        "gd",
        "imagick",
        "intl",
        "mbstring",
        "mysql",
        "opcache",
        "pgsql",
        "redis",
        "soap",
        "sqlite3",
        "xml",
        "zip"
      ]
    },
    "SiteType": {
      "type": "string",
      "enum": [
        "php",
        "static",
        "proxy"
      ]
    },
    "AcmeDirectory": {
      "type": "string",
      "enum": [
        "letsencrypt",
        "letsencrypt-staging",
        "pebble"
      ]
    },
    "CertInfo": {
      "type": "object",
      "properties": {
        "cert_uuid": {
          "$ref": "defs.schema.json#/$defs/Uuid"
        },
        "issuer": {
          "type": "string",
          "maxLength": 500
        },
        "not_before": {
          "type": "string"
        },
        "not_after": {
          "type": "string"
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/Domain"
          },
          "maxItems": 100
        }
      },
      "required": [
        "cert_uuid",
        "issuer",
        "not_before",
        "not_after",
        "domains"
      ],
      "additionalProperties": false
    },
    "DbEngine": {
      "type": "string",
      "enum": [
        "mariadb",
        "mysql",
        "postgresql"
      ]
    },
    "DbPrivileges": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ALL",
          "SELECT",
          "INSERT",
          "UPDATE",
          "DELETE",
          "CREATE",
          "DROP",
          "ALTER",
          "INDEX"
        ]
      },
      "maxItems": 9,
      "uniqueItems": true
    },
    "FileType": {
      "type": "string",
      "enum": [
        "file",
        "dir",
        "symlink",
        "other"
      ]
    },
    "Port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "IpAddress": {
      "type": "string",
      "maxLength": 45,
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$|^[0-9a-f:]{2,39}$",
      "description": "Một địa chỉ IPv4/IPv6 (không prefix). Tầng nghiệp vụ kiểm thêm octet ≤ 255."
    },
    "FirewallRule": {
      "type": "object",
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "action": {
          "type": "string",
          "enum": [
            "accept",
            "drop",
            "reject"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "in",
            "out"
          ]
        },
        "protocol": {
          "type": "string",
          "enum": [
            "tcp",
            "udp",
            "icmp",
            "any"
          ]
        },
        "ports": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "pattern": "^([0-9]{1,5}(-[0-9]{1,5})?)(,[0-9]{1,5}(-[0-9]{1,5})?)*$"
        },
        "source": {
          "$ref": "defs.schema.json#/$defs/Cidr"
        },
        "comment": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1f\"\\\\]*$"
        }
      },
      "required": [
        "priority",
        "action",
        "direction",
        "protocol",
        "ports",
        "source",
        "comment"
      ],
      "additionalProperties": false
    },
    "ConfirmToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,64}$",
      "description": "Token xác nhận safe-apply do agent sinh, dùng một lần (D-76)."
    },
    "Fail2banJail": {
      "type": "string",
      "enum": [
        "sshd",
        "itso-panel",
        "pure-ftpd"
      ]
    },
    "WafRuleId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999999,
      "description": "Id rule ModSecurity/CRS (số nguyên, không chuỗi tự do)."
    },
    "WafMode": {
      "type": "string",
      "enum": [
        "DetectionOnly",
        "On",
        "Off"
      ]
    },
    "ScanEngine": {
      "type": "string",
      "enum": [
        "clamav",
        "yara"
      ]
    },
    "AbsPath": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^/[^\\x00-\\x1f]*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      }
    },
    "NullableTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "BackupRepo": {
      "type": "object",
      "properties": {
        "repo_uuid": {
          "$ref": "defs.schema.json#/$defs/Uuid"
        },
        "destination_type": {
          "type": "string",
          "enum": [
            "local",
            "sftp",
            "s3",
            "rest"
          ]
        },
        "append_only": {
          "type": "boolean"
        }
      },
      "required": [
        "repo_uuid",
        "destination_type"
      ],
      "additionalProperties": false
    }
  }
}
