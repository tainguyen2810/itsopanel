{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itso.local/agent-ops/defs.schema.json",
  "title": "Kiểu dùng chung cho agent ops",
  "$defs": {
    "Domain": {
      "type": "string",
      "minLength": 4,
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+(xn--[a-z0-9-]{1,59}|[a-z]{2,63})$",
      "description": "Tên miền chữ thường, đã chuyển punycode. Kiểm thêm ở tầng nghiệp vụ: cấm localhost, IP, tên panel."
    },
    "Username": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,15}$",
      "not": {
        "enum": [
          "root",
          "admin",
          "www",
          "mysql",
          "postgres",
          "redis",
          "nginx",
          "itso",
          "daemon",
          "bin",
          "sys",
          "sync",
          "games",
          "man",
          "mail",
          "news",
          "proxy",
          "backup",
          "list",
          "nobody",
          "systemd",
          "sshd",
          "ftp",
          "test",
          "user",
          "support"
        ]
      },
      "description": "Username Linux của hosting account."
    },
    "RelPath": {
      "type": "string",
      "maxLength": 4096,
      "oneOf": [
        {
          "const": "."
        },
        {
          "pattern": "^[^/\\x00-\\x1f]+(/[^/\\x00-\\x1f]+)*$",
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        }
      ],
      "description": "Đường dẫn TƯƠNG ĐỐI với home của account. `.` là thư mục gốc. Cấm `..`, ký tự điều khiển, đường dẫn tuyệt đối."
    },
    "DbName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Tên database/DB user. Tầng nghiệp vụ bắt buộc tiền tố `<username>_`."
    },
    "CronExpr": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^([0-9*,/-]+) ([0-9*,/-]+) ([0-9*,/-]+) ([0-9*,/-]+) ([0-9*,/-]+)$",
      "description": "Biểu thức cron 5 trường dạng số. Khoảng tối thiểu theo gói kiểm ở tầng nghiệp vụ."
    },
    "CronCommand": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "not": {
        "pattern": "[\\r\\n\\x00]"
      },
      "description": "Lệnh chạy dưới UID của account. Một dòng, không ký tự xuống dòng (chống chèn crontab)."
    },
    "SecretPassword": {
      "type": "string",
      "minLength": 12,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~!@#%^*+=:,-]+$",
      "not": {
        "pattern": "[\\r\\n]"
      },
      "writeOnly": true,
      "description": "Mật khẩu DB/FTP/SFTP. Tới agent chỉ qua tham chiếu bí mật do JobRunner thay (D-69/D-71); không có dấu nháy, gạch chéo ngược, khoảng trắng."
    },
    "FtpUsername": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,47}$",
      "description": "Virtual user Pure-FTPd (D-73). Tầng nghiệp vụ bắt buộc tiền tố `<username>_`."
    },
    "NginxSize": {
      "type": "string",
      "pattern": "^[0-9]{1,5}[kmg]?$",
      "description": "Giá trị kích thước Nginx, ví dụ 64m."
    },
    "HeaderValue": {
      "type": "string",
      "maxLength": 512,
      "not": {
        "pattern": "[;{}\\r\\n\\x00\"'\\\\$]"
      },
      "description": "Giá trị đưa vào cấu hình Nginx: cấm ký tự phá cú pháp."
    },
    "PhpVersion": {
      "type": "string",
      "pattern": "^[5-9]\\.[0-9]$"
    },
    "UrlPath": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^/[A-Za-z0-9._~%/-]*$",
      "description": "Đường dẫn URL cho redirect/location: không khoảng trắng, dấu nháy, $, ;, {}."
    },
    "RedirectTarget": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^https?://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}(:[0-9]{1,5})?(/[A-Za-z0-9._~%/-]*)?$",
      "description": "URL đích redirect (http/https, domain chữ thường, path an toàn)."
    },
    "Cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}(/([0-9]|[12][0-9]|3[0-2]))?$|^[0-9a-f:]+(/[0-9]{1,3})?$"
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Uid": {
      "type": "integer",
      "minimum": 20000,
      "maximum": 59999,
      "description": "UID hosting account (D-07)."
    },
    "ServiceName": {
      "type": "string",
      "enum": [
        "nginx",
        "php8.1-fpm",
        "php8.2-fpm",
        "php8.3-fpm",
        "php8.4-fpm",
        "mariadb",
        "postgresql",
        "redis-server",
        "fail2ban",
        "cron",
        "ssh",
        "itso-gateway"
      ]
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
      "description": "Hostname máy chủ (RFC 1123, chữ thường)."
    },
    "Recipe": {
      "type": "string",
      "enum": [
        "acl",
        "quota",
        "nftables",
        "restic",
        "stress-ng",
        "nginx",
        "php8.3",
        "lego",
        "mariadb",
        "postgresql",
        "pure-ftpd",
        "fail2ban",
        "clamav",
        "yara",
        "modsecurity"
      ]
    },
    "QuotaMode": {
      "type": "string",
      "enum": [
        "kernel",
        "soft"
      ]
    },
    "Mode": {
      "type": "string",
      "pattern": "^0[0-7]{3}$"
    },
    "Bytes": {
      "type": "integer",
      "minimum": 0
    },
    "Limits": {
      "type": "object",
      "properties": {
        "disk_mb": {
          "type": "integer",
          "minimum": 1
        },
        "inode_limit": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6400
        },
        "ram_mb": {
          "type": "integer",
          "minimum": 64
        },
        "tasks_max": {
          "type": "integer",
          "minimum": 16
        },
        "io_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "io_read_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "io_write_bps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "disk_mb",
        "inode_limit",
        "cpu_percent",
        "ram_mb",
        "tasks_max",
        "io_weight",
        "io_read_bps",
        "io_write_bps"
      ],
      "additionalProperties": false
    },
    "Account": {
      "type": "object",
      "properties": {
        "username": {
          "$ref": "defs.schema.json#/$defs/Username"
        },
        "uid": {
          "$ref": "defs.schema.json#/$defs/Uid"
        }
      },
      "required": [
        "username",
        "uid"
      ],
      "additionalProperties": false
    },
    "Email": {
      "type": "string",
      "maxLength": 190,
      "pattern": "^[A-Za-z0-9._%+-]+@([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "PhpExtension": {
      "type": "string",
      "enum": [
        "bcmath",
        "curl",
        "gd",
        "imagick",
        "intl",
        "mbstring",
        "mysql",
        "opcache",
        "pgsql",
        "redis",
        "soap",
        "sqlite3",
        "xml",
        "zip"
      ]
    },
    "SiteType": {
      "type": "string",
      "enum": [
        "php",
        "static",
        "proxy"
      ]
    },
    "AcmeDirectory": {
      "type": "string",
      "enum": [
        "letsencrypt",
        "letsencrypt-staging",
        "pebble"
      ]
    },
    "CertInfo": {
      "type": "object",
      "properties": {
        "cert_uuid": {
          "$ref": "defs.schema.json#/$defs/Uuid"
        },
        "issuer": {
          "type": "string",
          "maxLength": 500
        },
        "not_before": {
          "type": "string"
        },
        "not_after": {
          "type": "string"
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/Domain"
          },
          "maxItems": 100
        }
      },
      "required": [
        "cert_uuid",
        "issuer",
        "not_before",
        "not_after",
        "domains"
      ],
      "additionalProperties": false
    },
    "DbEngine": {
      "type": "string",
      "enum": [
        "mariadb",
        "mysql",
        "postgresql"
      ]
    },
    "DbPrivileges": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ALL",
          "SELECT",
          "INSERT",
          "UPDATE",
          "DELETE",
          "CREATE",
          "DROP",
          "ALTER",
          "INDEX"
        ]
      },
      "maxItems": 9,
      "uniqueItems": true
    },
    "FileType": {
      "type": "string",
      "enum": [
        "file",
        "dir",
        "symlink",
        "other"
      ]
    },
    "Port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "IpAddress": {
      "type": "string",
      "maxLength": 45,
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$|^[0-9a-f:]{2,39}$",
      "description": "Một địa chỉ IPv4/IPv6 (không prefix). Tầng nghiệp vụ kiểm thêm octet ≤ 255."
    },
    "FirewallRule": {
      "type": "object",
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "action": {
          "type": "string",
          "enum": [
            "accept",
            "drop",
            "reject"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "in",
            "out"
          ]
        },
        "protocol": {
          "type": "string",
          "enum": [
            "tcp",
            "udp",
            "icmp",
            "any"
          ]
        },
        "ports": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "pattern": "^([0-9]{1,5}(-[0-9]{1,5})?)(,[0-9]{1,5}(-[0-9]{1,5})?)*$"
        },
        "source": {
          "$ref": "defs.schema.json#/$defs/Cidr"
        },
        "comment": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1f\"\\\\]*$"
        }
      },
      "required": [
        "priority",
        "action",
        "direction",
        "protocol",
        "ports",
        "source",
        "comment"
      ],
      "additionalProperties": false
    },
    "ConfirmToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,64}$",
      "description": "Token xác nhận safe-apply do agent sinh, dùng một lần (D-76)."
    },
    "Fail2banJail": {
      "type": "string",
      "enum": [
        "sshd",
        "itso-panel",
        "pure-ftpd"
      ]
    },
    "WafRuleId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999999,
      "description": "Id rule ModSecurity/CRS (số nguyên, không chuỗi tự do)."
    },
    "WafMode": {
      "type": "string",
      "enum": [
        "DetectionOnly",
        "On",
        "Off"
      ]
    },
    "ScanEngine": {
      "type": "string",
      "enum": [
        "clamav",
        "yara"
      ]
    },
    "AbsPath": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^/[^\\x00-\\x1f]*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      }
    },
    "NullableTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "ResticSnapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8,64}$",
      "description": "Id snapshot restic (hex 8–64); không nhận `latest` hay chuỗi tự do."
    },
    "BackupRepoPath": {
      "type": "string",
      "pattern": "^itso/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(acct-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|server)$",
      "description": "Đường dẫn repo trong đích, cố định theo server × account (D-82); agent dựng URL repo từ đây."
    },
    "BackupTag": {
      "type": "string",
      "pattern": "^(itso|type:(files|db|config|panel)|account:[0-9a-f-]{36}|website:[0-9a-f-]{36}|db:[a-z][a-z0-9_]{0,63}|policy:[0-9a-f-]{36}|manual|pre-restore|final)$",
      "description": "Tag snapshot theo danh sách cố định (D-82)."
    },
    "RepoPassword": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^[\\x21-\\x7e]+$",
      "writeOnly": true,
      "description": "Mật khẩu repo restic; tới agent qua tham chiếu bí mật `backup_repo_password` (D-69), agent ghi file 0600 rồi dùng RESTIC_PASSWORD_FILE, không qua argv."
    },
    "AgeRecipient": {
      "type": "string",
      "pattern": "^age1[02-9ac-hj-np-z]{58}$",
      "description": "Khóa công khai X25519 của panel (age, bech32)."
    },
    "BackupExclude": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._*?/@+-]+$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)|^/"
      },
      "description": "Mẫu loại trừ tương đối với home (restic --exclude), không tuyệt đối, không `..`."
    },
    "S3Bucket": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "HttpsUrl": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$"
    },
    "RemoteUser": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
    },
    "BackupDestination": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "local"
            },
            "destination_uuid": {
              "$ref": "defs.schema.json#/$defs/Uuid"
            }
          },
          "required": [
            "type",
            "destination_uuid"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "sftp"
            },
            "destination_uuid": {
              "$ref": "defs.schema.json#/$defs/Uuid"
            },
            "host": {
              "oneOf": [
                {
                  "$ref": "defs.schema.json#/$defs/Hostname"
                },
                {
                  "$ref": "defs.schema.json#/$defs/IpAddress"
                }
              ]
            },
            "port": {
              "$ref": "defs.schema.json#/$defs/Port"
            },
            "user": {
              "$ref": "defs.schema.json#/$defs/RemoteUser"
            },
            "path": {
              "$ref": "defs.schema.json#/$defs/AbsPath"
            },
            "host_key_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
            }
          },
          "required": [
            "type",
            "destination_uuid",
            "host",
            "port",
            "user",
            "path",
            "host_key_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "s3"
            },
            "destination_uuid": {
              "$ref": "defs.schema.json#/$defs/Uuid"
            },
            "endpoint": {
              "$ref": "defs.schema.json#/$defs/HttpsUrl"
            },
            "bucket": {
              "$ref": "defs.schema.json#/$defs/S3Bucket"
            },
            "region": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z0-9-]{2,32}$"
            },
            "access_key_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9/+=]{8,128}$"
            },
            "secret_access_key": {
              "type": "string",
              "minLength": 8,
              "maxLength": 256,
              "pattern": "^[\\x21-\\x7e]+$",
              "writeOnly": true
            }
          },
          "required": [
            "type",
            "destination_uuid",
            "endpoint",
            "bucket",
            "region",
            "access_key_id",
            "secret_access_key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "rest"
            },
            "destination_uuid": {
              "$ref": "defs.schema.json#/$defs/Uuid"
            },
            "url": {
              "$ref": "defs.schema.json#/$defs/HttpsUrl"
            },
            "user": {
              "$ref": "defs.schema.json#/$defs/RemoteUser"
            },
            "password": {
              "type": "string",
              "minLength": 8,
              "maxLength": 256,
              "pattern": "^[\\x21-\\x7e]+$",
              "writeOnly": true
            }
          },
          "required": [
            "type",
            "destination_uuid",
            "url",
            "user",
            "password"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Đích kiểu hóa (D-83): agent dựng URL repo (local:/var/backups/itso/repos/…, sftp:user@host:path/…, s3:endpoint/bucket/…, rest:https://user@host/…); credential chỉ là credential GHI, tới agent qua tham chiếu bí mật."
    },
    "CsrPem": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^-----BEGIN CERTIFICATE REQUEST-----\\n[A-Za-z0-9+/=\\n]+-----END CERTIFICATE REQUEST-----\\n?$",
      "description": "CSR PEM (ECDSA P-256) do node tự sinh; khóa riêng không rời node (D-90)."
    },
    "CertPem": {
      "type": "string",
      "maxLength": 16384,
      "pattern": "^(-----BEGIN CERTIFICATE-----\\n[A-Za-z0-9+/=\\n]+-----END CERTIFICATE-----\\n?)+$",
      "description": "Chứng chỉ PEM (có thể kèm chuỗi CA)."
    },
    "HttpCheckPath": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^/[A-Za-z0-9._~%/-]*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)|%2[eEfF]|//"
      },
      "description": "Đường dẫn tương đối gửi tới 127.0.0.1 của node (http.check); cấm traversal, mã hóa %2e/%2f, //."
    },
    "MigrationRole": {
      "type": "string",
      "enum": [
        "source",
        "target"
      ]
    },
    "MigrationCheck": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "files",
            "database",
            "http",
            "ssl",
            "cron",
            "ownership"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 255
        },
        "ok": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "kind",
        "name",
        "ok",
        "detail"
      ],
      "additionalProperties": false
    },
    "BackupRepo": {
      "type": "object",
      "properties": {
        "repo_uuid": {
          "$ref": "defs.schema.json#/$defs/Uuid"
        },
        "path": {
          "$ref": "defs.schema.json#/$defs/BackupRepoPath"
        },
        "destination": {
          "$ref": "defs.schema.json#/$defs/BackupDestination"
        },
        "password": {
          "$ref": "defs.schema.json#/$defs/RepoPassword"
        }
      },
      "required": [
        "repo_uuid",
        "path",
        "destination",
        "password"
      ],
      "additionalProperties": false
    },
    "BackupDb": {
      "type": "object",
      "properties": {
        "engine": {
