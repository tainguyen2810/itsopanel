# Xoay chứng chỉ node khi qua 2/3 hạn (ADR 0036 §3): panel gọi agent.cert.rotate hai pha + pki.sign_csr.
[Unit]
Description=ITSO Panel xoay chứng chỉ node
After=itso-redis.service postgresql@16-itso.service

[Service]
Type=oneshot
User=itso
Group=itso
Slice=itso-panel.slice
EnvironmentFile=/etc/itso/itso.env
WorkingDirectory=/opt/itso/current/api
ExecStart=/opt/itso/current/bin/frankenphp php-cli /opt/itso/current/api/artisan itso:certs-rotate
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/itso/current/api/storage /var/log/itso
PrivateTmp=yes
