# FrankenPHP (Caddy) của panel. Biến lấy từ /etc/itso/itso.env.
{
	admin off
	auto_https disable_redirects
	frankenphp
}

:{$ITSO_PANEL_PORT:28443} {
	tls /etc/itso/tls/panel.crt /etc/itso/tls/panel.key
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	log {
		output file /var/log/itso/web-access.log
	}

	# Terminal USER (D-75): WebSocket tới itso-gateway (loopback); gateway không quyết quyền.
	handle /gateway/* {
		reverse_proxy 127.0.0.1:{$ITSO_GATEWAY_PORT:7811}
	}

	# Endpoint nội bộ (enroll node) chỉ nhận qua listener loopback dưới đây, từ itso-relay.
	handle /api/v1/internal/* {
		respond 404
	}

	@api path /api/* /sanctum/* /up
	handle @api {
		# ASVS V13.1 (Prompt 12.4): chặn body lớn trước PHP; chunk upload File Manager 8 MB + phần đầu, Laravel kiểm chi tiết.
		request_body {
			max_size 10MB
		}
		root * /opt/itso/current/api/public
		php_server
	}
	handle /portal* {
		root * /opt/itso/current/web
		try_files {path} /portal/index.html
		file_server
	}
	handle {
		root * /opt/itso/current/web
		try_files {path} /admin/index.html
		file_server
	}
}

# Loopback cho itso-relay chuyển tiếp yêu cầu enroll node (ADR 0035); Laravel còn kiểm chữ ký relay.
http://127.0.0.1:28480 {
	bind 127.0.0.1
	@enroll path /api/v1/internal/nodes:enroll
	handle @enroll {
		root * /opt/itso/current/api/public
		php_server
	}
	handle {
		respond 404
	}
}
